{
  "name": "a-s-t",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && npm run format",
    "format": "prettier --write 'dist/**/*.html'",
    "preview": "astro preview",
    "lint": "eslint src/ --ext .astro,.ts,.svelte",
    "delivery": "astro build && npm run delivery:format && npm run delivery:copy && npm run delivery:list",
    "delivery:format": "prettier --write 'dist/**/*.html'",
    "delivery:copy": "node 'scripts/copyDirectory.js'",
    "delivery:list": "node 'scripts/makeFileList.js'",
    "preinstall": "node scripts/initialSetting.js",
    "check-ngword": "node 'scripts/checkNgWord.js'",
    "style-dictionary": "npm run style-dictionary:base && npm run style-dictionary:composite",
    "style-dictionary:base": "style-dictionary build --config ./sd.config.base.js",
    "style-dictionary:composite": "style-dictionary build --config ./sd.config.composite.js --verbose",
    "extract-diff-files": "node 'scripts/extractDiffFiles.mjs'"
  },
  "dependencies": {
    "@astrojs/mdx": "^5.0.3",
    "@astrojs/svelte": "^8.0.5",
    "@inquirer/prompts": "^8.4.2",
    "@types/fs-extra": "^11.0.4",
    "astro": "^6.1.8",
    "embla-carousel-svelte": "^8.6.0",
    "eslint": "^10.2.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-astro": "^1.7.0",
    "eslint-plugin-svelte": "^3.17.0",
    "fs-extra": "^11.3.4",
    "sharp": "^0.34.5",
    "svelte": "^5.55.4",
    "tree-node-cli": "^3.0.0",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@eslint/js": "^10.0.1",
    "@markuplint/astro-parser": "^4.6.23",
    "@typescript-eslint/eslint-plugin": "^8.58.2",
    "@typescript-eslint/parser": "^8.58.2",
    "glob": "^13.0.6",
    "globals": "^17.5.0",
    "node-html-parser": "^7.1.0",
    "postcss-html": "^1.8.1",
    "prettier": "^3.8.3",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-svelte": "^3.5.1",
    "sass": "^1.99.0",
    "style-dictionary": "^5.4.0",
    "stylelint": "^17.8.0",
    "stylelint-config-html": "^1.1.0",
    "stylelint-config-recess-order": "^7.7.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "svg-sprite": "^2.0.4"
  }
}
