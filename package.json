{
  "name": "a-s-t",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && npm run format",
    "format": "prettier --write 'dist/**/*.html'",
    "preview": "astro preview",
    "lint": "eslint src/ --ext .astro,.ts,.svelte",
    "delivery": "astro build && npm run delivery:format && npm run delivery:copy && npm run delivery:list",
    "delivery:format": "prettier --write 'dist/**/*.html'",
    "delivery:copy": "node 'scripts/copyDirectory.js'",
    "delivery:list": "node 'scripts/makeFileList.js'",
    "preinstall": "node scripts/initialSetting.js",
    "check-ngword": "node 'scripts/checkNgWord.js'",
    "style-dictionary": "npm run style-dictionary:base && npm run style-dictionary:composite",
    "style-dictionary:base": "style-dictionary build --config ./sd.config.base.js",
    "style-dictionary:composite": "style-dictionary build --config ./sd.config.composite.js --verbose",
    "extract-diff-files": "node 'scripts/extractDiffFiles.mjs'"
  },
  "dependencies": {
    "@astrojs/mdx": "^4.2.3",
    "@astrojs/svelte": "^7.0.9",
    "@inquirer/prompts": "^7.2.0",
    "@types/fs-extra": "^11.0.4",
    "astro": "^5.6.0",
    "fs-extra": "^11.2.0",
    "sharp": "^0.33.5",
    "svelte": "^5.8.1",
    "swiper": "^11.2.6",
    "tree-node-cli": "^1.6.0",
    "typescript": "^5.7.2"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@eslint/js": "^9.39.1",
    "@markuplint/astro-parser": "^4.6.14",
    "@typescript-eslint/eslint-plugin": "^8.17.0",
    "@typescript-eslint/parser": "^8.17.0",
    "eslint": "^9.16.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-astro": "^1.3.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-svelte": "^3.13.0",
    "glob": "^11.0.0",
    "globals": "^16.5.0",
    "markuplint": "^4.11.4",
    "node-html-parser": "^6.1.13",
    "postcss-html": "^1.7.0",
    "prettier": "^3.4.2",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-svelte": "^3.3.2",
    "sass": "^1.79.4",
    "style-dictionary": "^4.2.0",
    "stylelint": "^16.11.0",
    "stylelint-config-html": "^1.1.0",
    "stylelint-config-recess-order": "^5.1.1",
    "stylelint-config-standard-scss": "^14.0.0",
    "svg-sprite": "^2.0.4"
  }
}
