---
import SampleSrcImage from '@/image/sample.webp';
import SampleSrcImageSp from '@/image/sample_sp.webp';
import SampleSrcImagePc from '@/image/sample_pc.webp';
import ImageWrapper from '@/components/Image/ImageWrapper.svelte';
import PictureWrapper from '@/components/Image/PictureWrapper.svelte';
---

<div class="sample-images" id="images">
  <div class="sample-images_inner">
    <h2>Svelte Images</h2>
    <h3>ImageWrapper</h3>
    <ImageWrapper img={SampleSrcImage} alt="画像のせつめい" />
    <PictureWrapper img={{ sp: SampleSrcImageSp, md: SampleSrcImagePc }} alt="画像のせつめい" />
  </div>
</div>

<style lang="scss">
  @use '@/styles/_develop/+' as *;

  .sample-images {
    padding-block: var(--space-block);
    padding-inline: var(--space-inline);
  }

  .sample-images_inner {
    display: flex;
    flex-direction: column;
    gap: 1lh;
    align-items: center;
    width: 100%;
    max-width: var(--width-max);
    margin-inline: auto;
  }

  .sample-images_set {
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 100%;

    @include min-screen(md) {
      flex-direction: row;

      & > :global(*) {
        flex: 1;
        min-width: 0;
      }
    }
  }

  .box {
    width: rem(400);
    aspect-ratio: 1 / 1;
    background-image: url('@/image/sample.png');
    background-repeat: no-repeat;
    background-size: cover;
  }
</style>
