---
import CarouselSwiperVisible from '@/components/CarouselSwiper/CarouselSwiperVisible.svelte';
import CarouselSwiperResponsive from '@/components/CarouselSwiper/CarouselSwiperResponsive.svelte';
import CarouselSwiperCore from '@/components/CarouselSwiper/CarouselSwiperCore.svelte';
import CarouselSwiperSolo from '@/components/CarouselSwiper/CarouselSwiperSolo.svelte';
---

<div class="sample-carousel">
  <div class="sample-carousel_inner">
    <h2>Carousel</h2>
    <h3>Solo</h3>
    <CarouselSwiperSolo client:load />
    <h3>Respoinsive</h3>
    <CarouselSwiperResponsive client:load />
    <h3>Loop + CenteredSlides + UI</h3>
    <CarouselSwiperCore client:load />
    <h3>Overflow Visible</h3>
    <CarouselSwiperVisible client:load />
  </div>
</div>

<style lang="scss">
  .sample-carousel {
    padding-block: var(--space-block);
    padding-inline: var(--space-inline);
  }

  .sample-carousel_inner {
    display: flex;
    flex-direction: column;
    gap: 1lh;
    align-items: center;
    width: 100%;
    max-width: var(--width-max);
    margin-inline: auto;
  }
</style>
