---
import ModalSimple from '@/components/Modal/ModalSimple.svelte';
import ModalCarousel from '@/components/Modal/ModalCarousel.svelte';
---

<div class="sample-Modal" id="modal">
  <div class="sample-Modal_inner">
    <h2>Modal</h2>
    <h3>Simple Modal</h3>
    <ModalSimple client:load />
    <h3>Modal + Carousel</h3>
    <ModalCarousel client:load />
  </div>
</div>

<style lang="scss">
  .sample-Modal {
    padding-block: var(--space-block);
    padding-inline: var(--space-inline);
  }

  .sample-Modal_inner {
    display: flex;
    flex-direction: column;
    gap: 1lh;
    align-items: center;
    width: 100%;
    max-width: var(--width-max);
    margin-inline: auto;
  }
</style>
